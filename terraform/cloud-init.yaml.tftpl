#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl

write_files:
  - path: /opt/taskmaster/docker-compose.yml
    content: |
      services:
        db:
          image: postgres:17-alpine
          environment:
            POSTGRES_USER: postgres
            POSTGRES_PASSWORD: $${POSTGRES_PASSWORD:?}
            POSTGRES_DB: taskmaster
          volumes:
            - db-data:/var/lib/postgresql/data
          healthcheck:
            test: ["CMD-SHELL", "pg_isready -U postgres -d taskmaster"]
            interval: 5s
            timeout: 3s
            retries: 10
          restart: unless-stopped

        migrate:
          image: ghcr.io/jaroslavsku/bw-task-migrate:latest
          environment:
            DATABASE_URL: postgres://postgres:$${POSTGRES_PASSWORD:?}@db:5432/taskmaster
          depends_on:
            db:
              condition: service_healthy

        app:
          image: ghcr.io/jaroslavsku/bw-task:latest
          environment:
            DATABASE_URL: postgres://postgres:$${POSTGRES_PASSWORD:?}@db:5432/taskmaster
            JWT_SECRET: $${JWT_SECRET:?}
          ports:
            - "80:3000"
          depends_on:
            db:
              condition: service_healthy
            migrate:
              condition: service_completed_successfully
          healthcheck:
            test: ["CMD", "wget", "-qO-", "http://127.0.0.1:3000/api/health"]
            interval: 30s
            timeout: 5s
            retries: 3
          restart: unless-stopped

      volumes:
        db-data:
  - path: /opt/taskmaster/.env
    permissions: "0600"
    content: |
      POSTGRES_PASSWORD=${postgres_password}
      JWT_SECRET=${jwt_secret}

runcmd:
  - curl -fsSL https://get.docker.com | sh
  - cd /opt/taskmaster && docker compose pull && docker compose up -d
