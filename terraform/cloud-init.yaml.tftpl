#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl

write_files:
  - path: /opt/taskmaster/.env
    permissions: "0600"
    content: |
      POSTGRES_PASSWORD=${postgres_password}
      JWT_SECRET=${jwt_secret}
      DOMAIN=${domain}

runcmd:
  - curl -fsSL https://get.docker.com | sh
